{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "vercel/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "common/maxmind-db/GeoLite2-City.mmdb",
          "common/maxmind-db/GeoLite2-ASN.mmdb",
          "common/as-org-db/as-org2info.txt",
          "common/as-rel-db/as-rel2.txt",
          "common/peeringdb-db/peeringdb-index.json",
          "common/oui-db/oui.csv",
          "common/oui-db/mam.csv",
          "common/oui-db/oui36.csv",
          "common/oui-db/iab.csv",
          "common/oui-db/cid.csv"
        ],
        "excludeFiles": [
          "dist/**",
          "common/*-db/.*",
          "common/*-db/*.bak",
          "common/*-db/*.next"
        ]
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/vercel/server.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
